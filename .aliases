# Toolbox 통합 Aliases
# ~/.zshrc 또는 ~/.bashrc에 추가:
# source ~/github/koalakid1/toolbox/.aliases

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Homebrew PATH 설정 (아키텍처 자동 감지)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

if [[ "$(uname -m)" == "arm64" ]]; then
    # Apple Silicon Mac
    [[ -d "/opt/homebrew/bin" ]] && export PATH="/opt/homebrew/bin:$PATH"
else
    # Intel Mac
    [[ -d "/usr/local/bin" ]] && export PATH="/usr/local/bin:$PATH"
fi

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Toolbox 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Toolbox 재설치/설정 스크립트
alias toolbox='~/github/koalakid1/toolbox/setup-toolbox.sh'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Git 멀티 계정 관리
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# GitHub 레포지토리 클론 (대화형)
alias gclone='~/github/koalakid1/toolbox/git/clone-repo.sh'

# GitHub 계정 설정 (SSH/GPG 키 생성)
alias gsetup='~/github/koalakid1/toolbox/git/setup-account.sh'

# 필수 도구 설치 확인 (ssh-keygen, gpg, git)
alias ginstall='~/github/koalakid1/toolbox/git/install-required-tools.sh'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# S3cmd 설정 관리
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# S3 설정 생성
alias s3setup='~/github/koalakid1/toolbox/s3cmd/setup-s3-config.sh'

# S3 설정 전환
alias s3switch='~/github/koalakid1/toolbox/s3cmd/switch-s3.sh'

# S3 설정 목록
alias s3list='~/github/koalakid1/toolbox/s3cmd/list-s3-configs.sh'

# S3 설정 삭제
alias s3rm='~/github/koalakid1/toolbox/s3cmd/remove-s3-config.sh'

# 현재 활성 S3 설정 확인
alias s3current='if [ -L ~/.s3cfg ]; then basename $(readlink ~/.s3cfg); else echo "활성 설정 없음"; fi'

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# iTerm2 SSH Profile 관리
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# SSH Profile 자동 생성 (Password/PEM Key 지원)
alias issh='~/github/koalakid1/toolbox/iterm2/setup-ssh-profile.sh'
